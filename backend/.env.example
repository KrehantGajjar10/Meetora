# Meetora Backend Environment Variables
PROJECT_NAME="Meetora API"
VERSION="0.1.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# PostgreSQL Database URL
# For local host development:
DATABASE_URL="postgresql://meetora_user:meetora_password@localhost:5432/meetora_db"
# For Docker Compose internal network:
# DATABASE_URL="postgresql://meetora_user:meetora_password@db:5432/meetora_db"

# Allowed CORS Origins (comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
