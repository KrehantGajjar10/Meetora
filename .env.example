# Meetora - Root Environment Configuration (Docker Compose)

# PostgreSQL Configuration
POSTGRES_USER=meetora_user
POSTGRES_PASSWORD=meetora_password
POSTGRES_DB=meetora_db
POSTGRES_PORT=5432

# Backend API Configuration
API_PORT=8000
ENVIRONMENT=development
DATABASE_URL=postgresql://meetora_user:meetora_password@db:5432/meetora_db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
